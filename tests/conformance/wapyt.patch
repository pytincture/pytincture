diff --git a/tests/test_asset_ownership.py b/tests/test_asset_ownership.py
new file mode 100644
index 0000000..5cf501e
--- /dev/null
+++ b/tests/test_asset_ownership.py
@@ -0,0 +1,35 @@
+"""Portable ownership must preserve the legacy self-loader and avoid reexecution."""
+from types import SimpleNamespace
+import pytest
+from wapyt import _runtime
+
+
+def test_preloaded_assets_are_adopted_and_never_force_reloaded(monkeypatch):
+    calls = []
+    monkeypatch.setattr(_runtime, '_portable_assets_owner', False)
+    monkeypatch.setattr(_runtime, '_assets_loaded', False)
+    monkeypatch.setattr(_runtime, 'js', SimpleNamespace(
+        pytinctureAssets=SimpleNamespace(isPackageReady=lambda name:name=='wapyt'),
+        wapyt=SimpleNamespace(Chat=object()), eval=lambda source:calls.append(source)))
+    _runtime.use_preloaded_assets()
+    _runtime.require_js('Chat')
+    _runtime._load_assets(force=True)
+    with pytest.raises(RuntimeError, match='missing widget component'):
+        _runtime.require_js('Missing')
+    assert not calls
+
+
+def test_hook_rejects_partial_assets_and_legacy_can_still_load(monkeypatch):
+    monkeypatch.setattr(_runtime, '_portable_assets_owner', False)
+    monkeypatch.setattr(_runtime, '_assets_loaded', False)
+    js = SimpleNamespace(wapyt=SimpleNamespace())
+    monkeypatch.setattr(_runtime, 'js', js)
+    with pytest.raises(RuntimeError, match='not finished'):
+        _runtime.use_preloaded_assets()
+    calls = []
+    def load(force=False):
+        calls.append(force)
+        js.wapyt.Chat = object()
+    monkeypatch.setattr(_runtime, '_load_assets', load)
+    _runtime.require_js('Chat')
+    assert calls == [False]
