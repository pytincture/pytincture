+    if _portable_assets_owner:
+        return
     if js is None:
         return
     if _assets_loaded and not force:
@@ -106,6 +119,8 @@ def require_js(component: str) -> None:
     # offline fallback for when nothing else has injected the bundle.
     if _component_ready(component):
         return
+    if _portable_assets_owner:
+        raise RuntimeError(f"The portable asset manifest is missing widget component '{component}'")
     _load_assets()
     if not _component_ready(component):
         _load_assets(force=True)
