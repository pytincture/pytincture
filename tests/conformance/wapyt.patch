 _assets_loaded = False
+_portable_assets_owner = False
+
+
+def use_preloaded_assets() -> None:
+    """Pytincture's portable loader calls this only after verifying/loading the manifest."""
+    global _assets_loaded, _portable_assets_owner
+    registry = getattr(js, 'pytinctureAssets', None) if js is not None else None
+    if registry is None or not registry.isPackageReady('wapyt'):
+        raise RuntimeError('The portable widget asset manifest has not finished loading')
+    _assets_loaded = True
+    _portable_assets_owner = True
 
 
 def create_proxy(callback):  # type: ignore
@@ -54,6 +65,8 @@ def _load_assets(force: bool = False) -> None:
         force: When ``True`` the assets are reloaded even if we previously ran.
     """
