diff --git a/tests/runtime_server.py b/tests/runtime_server.py
new file mode 100644
index 0000000..658f0db
--- /dev/null
+++ b/tests/runtime_server.py
@@ -0,0 +1,62 @@
+"""Isolated authenticated local browser validation server (no production DB)."""
+import os
+import secrets
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+MODULES = ROOT / 'src/wawesomechat'
+CACHE = Path.home() / 'Library/Caches/pytincture-runtime-choice/wawesomechat'
+CACHE.mkdir(parents=True, exist_ok=True)
+os.environ['WA_ENV_FILE'] = str(CACHE / 'absent.env')
+os.environ['WA_DB_URL'] = 'sqlite:///' + str(CACHE / 'validation.db')
+os.environ['WA_SEED_PROVIDERS'] = '0'
+os.environ['OPENAI_BASE_URL'] = 'http://127.0.0.1:8094/test-provider/v1'
+os.environ['OPENAI_API_KEY'] = secrets.token_urlsafe(24)
+os.environ['MULTIPROXY_PROVIDER_CONFIG'] = '{"providers": {"openai": ["gpt-4o-mini","gpt-4o"]}}'
+os.environ['WHISPER_CACHE'] = str(CACHE.parent / 'whisper')
+os.environ['WA_DEFAULT_MODEL'] = 'gpt-4o-mini'
+sys.path.insert(0, str(MODULES))
+from pytincture import PytinctureConfig, create_app
+
+app = create_app(PytinctureConfig(
+    modules_path=str(MODULES), default_application='chat',
+    browser_runtime='pyodide', allow_runtime_selection=True,
+    delivery_mode=os.getenv('PYTINCTURE_TEST_DELIVERY_MODE', 'portable-bundle'),
+    allow_microphone=True,
+    enable_user_login=True, allow_development_auth_origin=True,
+    session_https_only=False, session_secret=secrets.token_urlsafe(48),
+    environment={
+        'ALLOWED_EMAILS': 'demo@example.com',
+        'AUTH_PASSWORD_HASHES': '{"demo@example.com":"$argon2id$v=19$m=65536,t=3,p=4$1nAFATBkZHf7FYm10EoAqw$bcQeiCVDJV5nH2dSoHhYtUlyLARtmS1ce7UBSUXokYQ"}',
+        'PYTINCTURE_PUBLIC_ASSET_PATHS': '{"chat":["browser/chat/*"]}',
+    },
+))
+# An OpenAI-compatible local fixture exercises LiteLLM plus the real BFF stream.
+# No paid provider or real credential is used in automated validation.
+import asyncio
+import json
+from fastapi import Request
+from starlette.responses import StreamingResponse
+
+@app.post('/test-provider/v1/chat/completions')
+async def completion(request: Request):
+    data = await request.json()
+    prompt = data['messages'][-1]['content']
+    answer = 'Validated streaming reply: ' + prompt
+    if 'python artifact' in prompt.lower():
+        answer = '::::Artifact Python Runtime Test | language=python\nprint("Python artifact executed")\n::::Artifact'
+    elif 'artifact' in prompt.lower():
+        answer = '::::Artifact Browser Test | renderer=iframe | language=html\n<h1>Runtime artifact works</h1>\n::::Artifact'
+    async def events():
+        for offset in range(0, len(answer), 12):
+            chunk = {'id':'local-validation', 'object':'chat.completion.chunk', 'created':1,
+                     'model':data['model'], 'choices':[{'index':0,'delta':{'content':answer[offset:offset+12]},'finish_reason':None}]}
+            yield 'data: ' + json.dumps(chunk) + '\n\n'
+            await asyncio.sleep(0.03)
+        yield 'data: [DONE]\n\n'
+    return StreamingResponse(events(), media_type='text/event-stream')
+
+if __name__ == '__main__':
+    import uvicorn
+    uvicorn.run(app, host='127.0.0.1', port=8094)
diff --git a/tests/test_browser_data.py b/tests/test_browser_data.py
new file mode 100644
index 0000000..e7d819f
--- /dev/null
+++ b/tests/test_browser_data.py
@@ -0,0 +1,36 @@
+"""Browser persistence must use the authenticated principal, never a client ID."""
+import sys
+from pathlib import Path
+import pytest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src/wawesomechat'))
+from browser_data import BrowserData
+
+
+def test_browser_history_is_scoped_to_authenticated_user(tmp_path,monkeypatch):
+    monkeypatch.setenv('WA_DB_FILE',str(tmp_path/'chat.db'))
+    monkeypatch.delenv('WA_DB_URL',raising=False)
+    alice=BrowserData(_user={'email':'alice@example.test'})
+    bob=BrowserData(_user={'email':'bob@example.test'})
+    alice.record_message('user','Only Alice can see this')
+    assert [row['content'] for row in alice.history()]==['Only Alice can see this']
+    assert bob.history()==[]
+    assert BrowserData(_user={'email':'alice@example.test'}).history()==alice.history()
+    with pytest.raises(ValueError):
+        alice.record_message('system','not an allowed transcript role')
+    with pytest.raises(ValueError):
+        alice.record_message('user','x'*100001)
+
+
+def test_browser_data_requires_authenticated_identity():
+    with pytest.raises(PermissionError):
+        BrowserData()
+
+
+def test_bootstrap_schemas_do_not_publish_stored_credentials(tmp_path,monkeypatch):
+    monkeypatch.setenv('WA_DB_FILE',str(tmp_path/'chat.db'))
+    monkeypatch.delenv('WA_DB_URL',raising=False)
+    data=BrowserData(_user={'email':'alice@example.test'}).bootstrap()
+    assert 'openai' in data['schemas']
+    assert data['secret_fields']['openai']['api_key']=='OPENAI_API_KEY'
+    assert all('secrets' not in schema for schema in data['schemas'].values())
