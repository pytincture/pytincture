new file mode 100644
index 0000000..97a4a83
--- /dev/null
+++ b/tests/browser_voice_smoke.py
@@ -0,0 +1,82 @@
+"""Browser voice E2E with synthetic microphone audio and real Whisper.
+
+A synthetic MediaStream avoids OS microphone prompts and records real WebM via
+MediaRecorder. It does not claim to validate physical microphones or OS permissions.
+"""
+import argparse
+import base64
+import json
+from pathlib import Path
+import re
+from playwright.sync_api import sync_playwright, expect
+
+
+def run(runtime, output):
+    output.mkdir(parents=True,exist_ok=True)
+    encoded=base64.b64encode((Path(__file__).parent/'fixtures/browser-voice.wav').read_bytes()).decode()
+    microphone='''navigator.mediaDevices.getUserMedia = async () => {
+      const ctx = new AudioContext(); await ctx.resume();
+      const bytes=Uint8Array.from(atob(AUDIO),c=>c.charCodeAt(0));
+      const buffer=await ctx.decodeAudioData(bytes.buffer);
+      const source=ctx.createBufferSource(); source.buffer=buffer;
+      const destination=ctx.createMediaStreamDestination(); source.connect(destination); source.start();
+      destination.stream.getTracks().forEach(track=>{
+        const stop=track.stop.bind(track); track.stop=()=>{stop(); if(ctx.state!=='closed')ctx.close();};
+      });
+      return destination.stream;
+    };'''.replace('AUDIO',json.dumps(encoded))
+    with sync_playwright() as pw:
+        browser=pw.chromium.launch()
+        context=browser.new_context(viewport={'width':1400,'height':900})
+        base='http://127.0.0.1:8094/chat'
+        login=context.request.get(base+'/login')
+        token=re.search(r'name="login_csrf_token" value="([^"]+)"',login.text())[1]
+        response=context.request.post(base+'/auth/user',form={'email':'demo@example.com','password':'demo-password','login_csrf_token':token},max_redirects=0)
+        assert response.status==303
+        page=context.new_page()
+        page.add_init_script(microphone)
+        errors,warnings,transcriptions=[],[],[]
+        page.on('pageerror',lambda error: errors.append(str(error)))
+        page.on('console',lambda message: errors.append(message.text) if message.type=='error' else warnings.append(message.text) if message.type=='warning' else None)
+        page.on('response',lambda response: transcriptions.append(response.status) if '/stt/stt/transcribe' in response.url.replace('.py/', '/') else None)
+        page.goto(base+'?runtime='+runtime)
+        page.locator('#pytincture-loading').wait_for(state='hidden',timeout=180000)
+        page.get_by_role('button',name='New chat',exact=True).wait_for(timeout=30000)
+        assert page.evaluate('document.featurePolicy.allowsFeature("microphone")')
+        page.get_by_role('button',name='New chat',exact=True).click()
+        button=page.get_by_role('button',name='Hold to talk',exact=True)
+        button.focus()
+        page.keyboard.down('Space')
+        expect(button).to_have_class(re.compile('recording'))
+        page.wait_for_timeout(3400)  # known duration of the synthetic speech fixture
+        page.keyboard.up('Space')
+        expect(page.get_by_placeholder('Message the assistant…')).to_have_value(re.compile('browser voice test',re.I),timeout=60000)
+        assert transcriptions==[200],transcriptions
+        print(runtime,'PASS push-to-talk recording, real Whisper and composer insertion',flush=True)
+        page.get_by_placeholder('Message the assistant…').fill('')
+        expect(page.get_by_text(re.compile('Validated streaming reply:.*browser voice test',re.I))).to_have_count(0)
+        page.get_by_role('button',name='Listen continuously',exact=True).click()
+        expect(page.get_by_text(re.compile('Validated streaming reply:.*browser voice test',re.I))).to_be_visible(timeout=60000)
+        page.get_by_title('Stop listening',exact=True).click()
+        expect(page.get_by_role('button',name='Listen continuously',exact=True)).to_have_attribute('aria-pressed','false')
+        assert transcriptions==[200,200],transcriptions
+        print(runtime,'PASS continuous listening, VAD, transcription, auto-send, reply and stop',flush=True)
+        page.screenshot(path=str(output/(runtime+'-voice.png')))
+        page.evaluate("() => { navigator.mediaDevices.getUserMedia=async()=>{throw new DOMException('Test microphone denied','NotAllowedError')}; }")
+        button.focus()
+        page.keyboard.down('Space')
+        page.keyboard.up('Space')
+        page.wait_for_timeout(300)
+        assert any('Microphone unavailable' in warning for warning in warnings),warnings
+        assert transcriptions==[200,200]
+        assert not errors,errors
+        print(runtime,'PASS denied microphone recovery and no browser errors',flush=True)
+        (output/(runtime+'-voice.json')).write_text(json.dumps({'runtime':runtime,'transcription_statuses':transcriptions,'errors':errors,'synthetic_microphone':True,'real_whisper':True},indent=2))
+        browser.close()
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--runtime',default='micropython')
+    parser.add_argument('--output',type=Path,default=Path.home()/'Library/Caches/pytincture-runtime-choice/wawesome-results')
+    args=parser.parse_args()
+    run(args.runtime,args.output)
