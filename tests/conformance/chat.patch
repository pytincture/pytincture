+"""Authenticated browser data; database and environment imports stay on the server."""
+import copy
+import hashlib
+from pytincture.dataclass import backend_for_frontend
+from config import settings_from_env
+from provider_catalog import DEFAULT_PROVIDER_CATALOG, _build_schemas_from_rows, _load_seed_rows, _secret_map
+from storage import ChatStorage
+
+
+@backend_for_frontend
+class BrowserData:
+    def __init__(self, _user=None):
+        identity = (_user or {}).get('email')
+        if not identity:
+            raise PermissionError('An authenticated user is required')
+        self._session = 'user:' + hashlib.sha256(identity.encode()).hexdigest()
+        self._storage = ChatStorage(settings_from_env().database)
+
+    def bootstrap(self):
+        # Schemas come from the public seed catalog, never stored credential values.
+        schemas = _build_schemas_from_rows(_load_seed_rows())
+        return {'catalog': copy.deepcopy(DEFAULT_PROVIDER_CATALOG), 'schemas': schemas,
+                'secret_fields': {slug: _secret_map(schema.get('credentials', {}))
+                                  for slug, schema in schemas.items()}}
+
+    def history(self, limit=100):
+        return [{'role': row.role, 'content': row.content, 'timestamp': row.created_at.isoformat()}
+                for row in self._storage.history(self._session, limit=max(1, min(int(limit), 100)))]
+
+    def record_message(self, role, content, model=None, provider=None):
+        if role not in {'user', 'assistant'} or not isinstance(content, str) or len(content) > 100000:
+            raise ValueError('Invalid chat message')
+        self._storage.record_message(session_id=self._session, role=role, content=content,
+                                     model=model, provider=provider)
+        return True
