@@ -0,0 +1,85 @@
+"""Exercise full-app interactions without changing stored book records."""
+import argparse
+import json
+import re
+from pathlib import Path
+from playwright.sync_api import expect, sync_playwright
+
+BASE = 'http://127.0.0.1:8095'
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--runtime',choices=['pyodide','micropython'],action='append')
+parser.add_argument('--output',type=Path,default=Path.home()/'Library/Caches/pytincture-runtime-choice/latest-example-interactions')
+args = parser.parse_args()
+OUT = args.output
+OUT.mkdir(parents=True,exist_ok=True)
+results = {}
+
+with sync_playwright() as pw:
+    browser = pw.chromium.launch()
+    context = browser.new_context(viewport={'width':1400,'height':900})
+    response = context.request.get(BASE+'/py_ui/login')
+    csrf = re.search(r'name="login_csrf_token" value="([^"]+)"',response.text())[1]
+    assert context.request.post(BASE+'/py_ui/auth/user',form={
+        'email':'demo@example.com','password':'demo-password','login_csrf_token':csrf,
+    },max_redirects=0).status == 303
+    for runtime in args.runtime or ('micropython','pyodide'):
+        page = context.new_page()
+        errors = []
+        requests = []
+        page.on('pageerror',lambda error:errors.append(str(error)))
+        page.on('console',lambda message:errors.append(message.text) if message.type=='error' else None)
+        page.on('request',lambda request:requests.append(request.url))
+        page.goto(BASE+'/py_ui?runtime='+runtime)
+        page.locator('#pytincture-loading').wait_for(state='hidden',timeout=180000)
+        page.locator('.dhx_grid-row').first.wait_for(timeout=30000)
+        assert page.locator('body').get_attribute('data-browser-runtime') == runtime
+        for widget in ('.dhx_grid','.dhx_toolbar','.dhx_sidebar','.dhx_tabbar'):
+            assert page.locator(widget).count() == 1
+
+        sidebar = page.locator('.dhx_sidebar')
+        width = sidebar.bounding_box()['width']
+        page.locator('[data-dhx-id="hamburger"]').click()
+        page.wait_for_function('(width)=>document.querySelector(".dhx_sidebar").getBoundingClientRect().width<width',arg=width)
+        page.locator('[data-dhx-id="hamburger"]').click()
+        page.wait_for_function('(width)=>document.querySelector(".dhx_sidebar").getBoundingClientRect().width===width',arg=width)
+
+        row = page.locator('.dhx_grid-row').nth(2)
+        title = row.locator('.dhx_grid-cell').first.inner_text().strip()
+        row.click()
+        page.get_by_text('FORM VIEW').click()
+        assert page.locator('.dhx_form input').first.input_value() == title
+
+        page.get_by_text('CALENDAR VIEW').click()
+        calendar = page.locator('.dhx_calendar:visible')
+        month = calendar.locator('.dhx_calendar-action__show-month').inner_text()
+        calendar.get_by_role('button',name='next',exact=True).click()
+        expect(calendar.locator('.dhx_calendar-action__show-month')).not_to_have_text(month)
+        day = calendar.locator('.dhx_calendar-day:not(.dhx_calendar-day--muffled)').filter(has_text=re.compile('^15$'))
+        day.click()
+        expect(day).to_have_attribute('aria-pressed', 'true')
+
+        page.get_by_text('GRID VIEW').click()
+        row.locator('.dhx_grid-cell').first.click(button='right')
+        try:
+            page.locator('.dhx_menu [data-dhx-id="edit"]').click(timeout=5000)
+        except Exception:
+            print('Context menu failure:', errors, page.locator('.dhx_menu').all_inner_texts(), flush=True)
+            page.screenshot(path=str(OUT/f'{runtime}-failure.png'))
+            raise
+        page.locator('.dhx_window input').first.wait_for()
+        assert page.locator('.dhx_window input').first.input_value() == title
+        page.locator('.dhx_window [data-dhx-id="close"]').click()
+        page.locator('.dhx_window').wait_for(state='detached')
+        assert not errors, errors
+        loaded_pyodide = any('/pyodide/' in url for url in requests)
+        assert loaded_pyodide == (runtime == 'pyodide')
+        page.screenshot(path=str(OUT/f'{runtime}-full-app.png'))
+        results[runtime] = {
+            'full_app':True,'widgets_built_once':True,'sidebar_toggle':True,
+            'form_mirrors_selection':True,'calendar_navigation_and_selection':True,
+            'context_menu_edit':True,'loaded_pyodide':loaded_pyodide,'console_errors':errors,
+        }
+        print(runtime,results[runtime],flush=True)
+        page.close()
+    browser.close()
+(OUT/'interactions.json').write_text(json.dumps(results,indent=2)+'\n')
