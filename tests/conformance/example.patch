@@ -0,0 +1,25 @@
+"""Authenticated isolated service for local full-application runtime validation."""
+import os
+import secrets
+import sys
+from dataclasses import replace
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+CACHE = Path.home()/'Library/Caches/pytincture-runtime-choice'
+CACHE.mkdir(parents=True, exist_ok=True)
+os.environ['PYTINCTURE_EXAMPLE_DB'] = str(CACHE/'latest-books.db')
+os.environ['PYTINCTURE_EXAMPLE_SESSION_SECRET'] = secrets.token_urlsafe(48)
+sys.path.insert(0, str(ROOT/'example'))
+import run
+from pytincture import create_app
+
+app = create_app(replace(
+    run.app.state.pytincture_config, allow_runtime_selection=True,
+    delivery_mode=os.getenv("PYTINCTURE_TEST_DELIVERY_MODE", "portable-bundle"),
+    environment={**run.app.state.pytincture_config.environment,
+                 'PYTINCTURE_PUBLIC_ASSET_PATHS':'{"py_ui":["browser/py_ui/*"]}'},
+))
+if __name__ == '__main__':
+    import uvicorn
+    uvicorn.run(app,host='127.0.0.1',port=8095)
